    "views": {
        "overview": {
            "title": "Overview",
            "description": "Check status, coverage and match counts.",
            "transformation": {
                "flatten": [
                    "query",
                    "summary",
                    "coverage",
                    "billing"
                ],
                "fields": [
                    "status",
                    "query.type",
                    "summary.matchedNoticeCount",
                    "summary.activeCount",
                    "summary.categoriesMatched",
                    "coverage.completeForRequestedLayers",
                    "coverage.categoriesFailed",
                    "billing.billable",
                    "checkedAt"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "status": {
                        "label": "Status",
                        "format": "text"
                    },
                    "query.type": {
                        "label": "Query",
                        "format": "text"
                    },
                    "summary.matchedNoticeCount": {
                        "label": "Matched notices",
                        "format": "number"
                    },
                    "summary.activeCount": {
                        "label": "Active",
                        "format": "number"
                    },
                    "summary.categoriesMatched": {
                        "label": "Categories matched",
                        "format": "array"
                    },
                    "coverage.completeForRequestedLayers": {
                        "label": "All layers checked",
                        "format": "boolean"
                    },
                    "coverage.categoriesFailed": {
                        "label": "Failed categories",
                        "format": "array"
                    },
                    "billing.billable": {
                        "label": "Billable",
                        "format": "boolean"
                    },
                    "checkedAt": {
                        "label": "Checked at",
                        "format": "date"
                    }
                }
            }
        },
        "notices": {
            "title": "Notices",
            "description": "One row per matched official USCG notice.",
            "transformation": {
                "unwind": [
                    "notices"
                ],
                "fields": [
                    "category",
                    "title",
                    "validity",
                    "effectiveWindow.start",
                    "effectiveWindow.end",
                    "relationshipToQuery.minimumDistanceNm",
                    "relationshipToQuery.routePosition",
                    "source.datasetUrl"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "category": {
                        "label": "Category",
                        "format": "text"
                    },
                    "title": {
                        "label": "Title",
                        "format": "text"
                    },
                    "validity": {
                        "label": "Validity",
                        "format": "text"
                    },
                    "effectiveWindow.start": {
                        "label": "Start",
                        "format": "text"
                    },
                    "effectiveWindow.end": {
                        "label": "End",
                        "format": "text"
                    },
                    "relationshipToQuery.minimumDistanceNm": {
                        "label": "Distance (nm)",
                        "format": "number"
                    },
                    "relationshipToQuery.routePosition": {
                        "label": "Route position",
                        "format": "number"
                    },
                    "source.datasetUrl": {
                        "label": "Dataset",
                        "format": "link"
                    }
                }
            }
